{
  "distro": "Ubuntu-24.04",
  "opencode_bin": "~/.local/bin/opencode",
  "opencode_port": 48186,
  "broker_port": 48187,
  "max_concurrency": 2,
  "result_view": "compact",
  "result_max_chars": 2500,
  "check_output_chars": 2000,
  "stale_warning_seconds": 120,
  "default_model": "opencode-go/deepseek-v4.1-flash",
  "allowed_providers": ["opencode-go"],
  "model_cache_seconds": 60,
  "provider_caps": {},
  "model_caps": {},
  "worker_profiles": {
    "read_fast": {"model": "opencode-go/deepseek-v4.1-flash", "isolation": "readonly"},
    "code_fast": {"model": "opencode-go/deepseek-v4.1-flash", "isolation": "worktree"}
  },
  "enable_questions": false,
  "require_verification": true,
  "allowed_roots": [
    "~/projects"
  ],
  "default_timeout_seconds": 1800
}
